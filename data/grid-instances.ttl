@prefix data: <http://grid.ontology.local/data#> .
@prefix grid: <http://grid.ontology.local/onto#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:BR1 a grid:Breaker,
        grid:Switch ;
    rdfs:label "F01线出线断路器"@zh ;
    grid:belongsToFeeder data:FX ;
    grid:code "BR1" ;
    grid:connectsFrom data:FX ;
    grid:connectsTo data:LS1 ;
    grid:hasOperatingState grid:ClosedState ;
    grid:normallyOpen false ;
    rdfs:comment "变电站出线开关，断开即整条馈线失电。"@zh .

data:BR2 a grid:Breaker,
        grid:Switch ;
    rdfs:label "F02线出线断路器"@zh ;
    grid:belongsToFeeder data:FY ;
    grid:code "BR2" ;
    grid:connectsFrom data:FY ;
    grid:connectsTo data:LS4 ;
    grid:hasOperatingState grid:ClosedState ;
    grid:normallyOpen false ;
    rdfs:comment "F02 线出线开关。"@zh .

