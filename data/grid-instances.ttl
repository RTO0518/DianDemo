data:LS3 a grid:LineSection ;
    rdfs:label "F01线工业园支线"@zh ;
    grid:belongsToFeeder data:FX ;
    grid:code "LS3" ;
    grid:lengthKM "2.1"^^xsd:float ;
    grid:upstreamOf data:LS2 ;
    rdfs:comment "经 S2 引出的支线，仅供电给城东工业园台区，末端无联络。"@zh .

data:LS1 a grid:LineSection ;
    rdfs:label "F01线出口段"@zh ;
    grid:belongsToFeeder data:FX ;
    grid:code "LS1" ;
