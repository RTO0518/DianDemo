data:LS2 a grid:LineSection ;
    rdfs:label "F01线主干段"@zh ;
    grid:belongsToFeeder data:FX ;
    grid:code "LS2" ;
    grid:lengthKM "3.4"^^xsd:float ;
    grid:upstreamOf data:LS1 ;
    rdfs:comment "S1 与 S2 之间的主干段，金桥小区、阳光花园两个台区挂接于此段。"@zh .

data:FY a grid:Feeder ;
    rdfs:label "城东F02线"@zh ;
