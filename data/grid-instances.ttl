data:GD_2026_018 a grid:MaintenanceOrder ;
    rdfs:label "工业园支线计划检修"@zh ;
    grid:assignedToTeam data:TEAM1 ;
    grid:code "GD_2026_018" ;
    grid:orderStatus "已批准"@zh ;
    grid:plannedEnd "2026-12-05T12:00:00"^^xsd:dateTime ;
    grid:plannedStart "2026-12-05T08:00:00"^^xsd:dateTime ;
    grid:priority 2 ;
    grid:targetsEquipment data:LS3 .

data:GD_2026_019 a grid:MaintenanceOrder ;
    rdfs:label "主干段电缆故障抢修"@zh ;
    grid:assignedToTeam data:TEAM1 ;
    grid:code "GD_2026_019" ;
    grid:handlesFault data:F1 ;
    grid:orderStatus "执行中"@zh ;
    grid:plannedEnd "2026-11-24T23:30:00"^^xsd:dateTime ;
    grid:plannedStart "2026-11-24T20:05:00"^^xsd:dateTime ;
    grid:priority 1 ;
    grid:targetsEquipment data:LS2 .

data:L1 a grid:Switch,
        grid:TieSwitch ;
    rdfs:label "城东联络开关"@zh ;
    grid:belongsToFeeder data:FX ;
    grid:code "L1" ;
    grid:connectsFeeder data:FX,
        data:FY ;
    grid:connectsFrom data:LS2 ;
    grid:connectsTo data:LS4 ;
    grid:hasOperatingState grid:OpenState ;
    grid:normallyOpen true ;
    rdfs:comment "F01 与 F02 之间的联络点，常态分位；合闸可把 F01 下游负荷转移至 F02。"@zh .

data:S1 a grid:SectionSwitch,
        grid:Switch ;
    rdfs:label "一号分段开关"@zh ;
    grid:belongsToFeeder data:FX ;
    grid:code "S1" ;
    grid:connectsFrom data:LS1 ;
    grid:connectsTo data:LS2 ;
    grid:hasOperatingState grid:ClosedState ;
    grid:normallyOpen false ;
    rdfs:comment "主干分段点，断开后 LS2、LS3 及所带三个台区失电。"@zh .

data:S2 a grid:SectionSwitch,
        grid:Switch ;
    rdfs:label "二号分段开关"@zh ;
    grid:belongsToFeeder data:FX ;
    grid:code "S2" ;
    grid:connectsFrom data:LS2 ;
    grid:connectsTo data:LS3 ;
    grid:hasOperatingState grid:ClosedState ;
    grid:normallyOpen false ;
    rdfs:comment "工业园支线分支开关，断开后仅城东工业园台区失电。"@zh .

data:F1 a grid:Fault ;
    rdfs:label "F01线主干段电缆击穿"@zh ;
    grid:affectsEquipment data:LS2 ;
    grid:code "F1" ;
    grid:durationMinutes 78 ;
    grid:faultTime "2026-11-24T19:42:00"^^xsd:dateTime ;
    grid:faultType "电缆绝缘击穿"@zh ;
    rdfs:comment "晚高峰负荷突增导致电缆中间接头绝缘击穿，S1 保护动作跳闸。"@zh .

