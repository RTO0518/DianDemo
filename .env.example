# ---------- 模型配置 ----------
# openai_compat：接入任何 OpenAI 协议兼容的模型（在线 API 或本地推理框架）
# mock：离线规则模式，断网也能演示，数字同样来自推理引擎
LLM_PROVIDER=mock

# 在线：DeepSeek / 通义 / 智谱 等，填对应的 base_url 与 key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxxxxxx

# 本地部署时只改 base_url，代码不用动：
# vLLM      LLM_BASE_URL=http://127.0.0.1:8000/v1
# Ollama    LLM_BASE_URL=http://127.0.0.1:11434/v1
# LM Studio LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60
MAX_TOOL_ROUNDS=5

# ---------- 服务配置 ----------
HOST=127.0.0.1
PORT=8000
